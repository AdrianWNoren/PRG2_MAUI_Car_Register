<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:PRG_MAUI_Car_Register.ViewModel"
             xmlns:converters="clr-namespace:PRG_MAUI_Car_Register.Converters"
             x:Class="PRG_MAUI_Car_Register.MainPage"
             Title="Lägg till fordon">

    <ContentPage.Resources>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
    </ContentPage.Resources>


    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Image Source="car.jpg" Aspect="AspectFit" HeightRequest="150" Margin="0,0,0,20"/>

            <HorizontalStackLayout Spacing="20" HorizontalOptions="StartAndExpand">
                <Entry Placeholder="Registreringsnummer" 
                       Text="{Binding RegistrationNumber}"
                       WidthRequest="200" />
                <Label Text="Välj typ:" VerticalOptions="Center"/>
                <Picker SelectedIndex="{Binding SelectedType}"
                        TextColor="DarkRed"
                        WidthRequest="120">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Bil</x:String>
                            <x:String>MC</x:String>
                            <x:String>Lastbil</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </HorizontalStackLayout>

            <Entry Placeholder="Tillverkare" 
                   Text="{Binding Manufacturer}" />
            <Entry Placeholder="Modell" 
                   Text="{Binding Model}" />

            <Entry Placeholder="Årsmodell" 
                   Text="{Binding YearModel}"
                   Keyboard="Numeric" />


            <Button Text="Registrera fordon" 
                    Command="{Binding RegisterCommand}" 
                    Margin="0,0,0,20" 
                    BackgroundColor="DarkRed"
                    TextColor="White"/>

            <Label Text="Filtrera fordon:" FontAttributes="Bold" />
            <HorizontalStackLayout HorizontalOptions="Center" Margin="0,0,0,20" Spacing="10">
                <RadioButton Content="Alla" 
                           IsChecked="{Binding SelectedFilter, Converter={StaticResource StringToBoolConverter}, ConverterParameter=All}"
                           GroupName="Filter" />
                <RadioButton Content="Bilar" 
                           IsChecked="{Binding SelectedFilter, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Cars}"
                           GroupName="Filter" />
                <RadioButton Content="MC" 
                           IsChecked="{Binding SelectedFilter, Converter={StaticResource StringToBoolConverter}, ConverterParameter=MC}"
                           GroupName="Filter" />
                <RadioButton Content="Lastbilar" 
                           IsChecked="{Binding SelectedFilter, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Trucks}"
                           GroupName="Filter" />
            </HorizontalStackLayout>
            <Label Text="Registrerade fordon:" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding FilteredVehicles}" 
                          HeightRequest="200"
                          Margin="0,0,0,20">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" ColumnDefinitions="100,80,100,100,80">
                            <Label Text="{Binding RegistrationNumber}" Grid.Column="0" />
                            <Label Text="{Binding VehicleType}" Grid.Column="1" />
                            <Label Text="{Binding Manufacturer}" Grid.Column="2" />
                            <Label Text="{Binding Model}" Grid.Column="3" />
                            <Label Text="{Binding YearModel}" Grid.Column="4" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

     
            <Label Text="Sök fordon:" FontAttributes="Bold" />
            <HorizontalStackLayout HorizontalOptions="FillAndExpand" Spacing="20">
                <Entry Placeholder="Ange registreringsnummer" 
                       Text="{Binding SearchRegistrationNumber}"
                       HorizontalOptions="FillAndExpand" />
                <Button Text="Sök" 
                        Command="{Binding SearchCommand}"
                        HorizontalOptions="End" 
                        BackgroundColor="DarkRed" 
                        TextColor="White"/>
            </HorizontalStackLayout>

            <Label Text="{Binding SearchResult}" 
                   TextColor="DarkRed" 
                   Margin="0,20,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>